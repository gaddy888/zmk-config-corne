#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            global-quick-tap;
            require-prior-idle-ms = <200>;
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            label = "PARA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            label = "PARALESS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            label = "PARAGREAT";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shift_tolayer: shift_tolayer {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_TOLAYER";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&tog 5>;

            tapping-term-ms = <100>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        shift_caps_word: shift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS_WORD";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        period_comma: period_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "PERIOD_COMMA";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp COMMA>;

            tapping-term-ms = <400>;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            global-quick-tap;
            require-prior-idle-ms = <200>;
            hold-trigger-key-positions = <1 0 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            global-quick-tap;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        tile_left: tile_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp GLOBE>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp GLOBE>;

            label = "TILE_LEFT";
        };

        tile_right: tile_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp GLOBE>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp GLOBE>;

            label = "TILE_RIGHT";
        };
    };

    combos {
        compatible = "zmk,combos";

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <31 19>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
        };

        para-great {
            bindings = <&paragreat>;
            key-positions = <20 21>;
        };

        Exclamation {
            bindings = <&kp EXCL>;
            key-positions = <1 13>;
        };

        Carret {
            bindings = <&kp CARET>;
            key-positions = <6 18>;
        };

        LeftBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
        };

        RightBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 19>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <11 10>;
        };

        para_left {
            bindings = <&paraless>;
            key-positions = <4 5>;
        };

        para_right {
            bindings = <&paragreat>;
            key-positions = <6 7>;
        };

        to_numpad {
            bindings = <&tog 4>;
            key-positions = <35 40>;
            require-prior-idle-ms = <400>;
            timeout-ms = <30>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <21 33>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <22 34>;
        };

        ctrl_command {
            bindings = <&sk LC(GLOBE)>;
            key-positions = <13 25>;
        };

        to_layer5 {
            bindings = <&tog 5>;
            key-positions = <24 37>;
            require-prior-idle-ms = <400>;
            timeout-ms = <30>;
        };

        to_mouse_num_R {
            bindings = <&mo 4>;
            key-positions = <23 35>;
            require-prior-idle-ms = <200>;
        };

        to_mouse_num_L {
            bindings = <&mo 4>;
            key-positions = <12 24>;
            require-prior-idle-ms = <200>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp GRAVE       &kp Q                     &kp W                 &kp E                     &kp R  &kp T                     &kp Y                    &kp U      &kp I                           &kp O                     &kp P                          &backspace_delete
&kp TAB         &kp A                     &kp S                 &kp D                     &kp F  &kp G                     &kp H                    &kp J      &kp K                           &kp L                     &kp SEMICOLON                  &kp SQT
&kp LEFT_SHIFT  &hrm_left LEFT_CONTROL Z  &hrm_left LEFT_ALT X  &hrm_left LEFT_COMMAND C  &kp V  &kp B                     &kp N                    &kp M      &hrm_right RIGHT_COMMAND COMMA  &hrm_right RIGHT_ALT DOT  &hrm_right RIGHT_CONTROL FSLH  &kp RSHFT
                                                                &kp LGUI                  &mo 1  &hm LEFT_CONTROL SPACE    &hm RIGHT_CONTROL ENTER  &lt 2 TAB  &kp LEFT_ALT
            >;
        };

        NUM_SYM {
            display-name = "Numbers_Symbols";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp ESC     &kp N1            &kp N2        &kp N3           &kp N4         &kp N5         &kp N6          &kp N7     &kp PIPE         &paraless         &paragreat         &trans
&caps_word  &kp NUMBER_6      &kp N7        &kp N8           &kp N9         &kp N0         &kp MINUS       &kp EQUAL  &kp KP_MULTIPLY  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp HOME
&trans      &sk LEFT_CONTROL  &sk LEFT_ALT  &kp KP_ASTERISK  &kp KP_DIVIDE  &browsertab    &kp UNDERSCORE  &kp PLUS   &kp BACKSLASH    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp END
                                            &sk LGUI         &trans         &trans         &trans          &trans     &sk LEFT_ALT
            >;
        };

        SYM_NAV {
            display-name = "Symbols_Navigation";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL          &kp AT         &kp HASH        &kp DLLR         &kp PRCNT     &kp PAGE_UP    &kp AMPS  &kp UP_ARROW    &browsertab    &kp HOME           &trans
&trans  &kp CARET         &kp AMPERSAND  &kp STAR        &paraless        &paragreat    &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT      &kp END            &trans
&trans  &sk LEFT_CONTROL  &sk LEFT_ALT   &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp TILDE     &kp UNDER      &none     &none           &sk RIGHT_ALT  &sk RIGHT_CONTROL  &trans
                                         &kp LGUI        &trans           &trans        &trans         &trans    &trans
            >;
        };

        ADJ {
            display-name = "System";
            bindings = <
&trans  &kp F1            &kp F2        &kp F3            &kp F4      &kp F5            &kp F6  &kp F7           &kp F8         &kp F9        &kp F10            &bt BT_CLR
&trans  &kp F11           &kp F12       &bt BT_PRV        &bt BT_NXT  &studio_unlock    &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp LEFT_ALT  &kp RIGHT_CONTROL  &bt BT_CLR_ALL
&trans  &sk LEFT_CONTROL  &sk LEFT_ALT  &sk LEFT_COMMAND  &none       &soft_off         &trans  &trans           &trans         &trans        &bootloader        &trans
                                        &kp LEFT_GUI      &trans      &trans            &trans  &trans           &trans
            >;
        };

        MouseNum {
            display-name = "MouseNum";
            bindings = <
&trans          &trans            &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP      &kp KP_MULTIPLY  &kp N7        &kp N8        &kp N9        &kp KP_PLUS      &trans
&msc SCRL_LEFT  &msc SCRL_RIGHT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &kp KP_DIVIDE    &kp N4        &kp N5        &kp NUMBER_6  &kp KP_SUBTRACT  &kp EQUAL
&trans          &sk LEFT_CONTROL  &sk LEFT_ALT    &mkp MB3        &none            &trans            &kp KP_NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &period_comma    &trans
                                                  &kp LEFT_GUI    &trans           &trans            &trans           &trans        &kp LEFT_ALT
            >;
        };

        controls {
            bindings = <
&trans          &kp C_BRI_DEC     &kp C_BRI_INC  &kp C_REWIND      &kp K_PLAY_PAUSE  &kp C_FAST_FORWARD    &kp K_MUTE  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans  &trans
&trans          &trans            &trans         &trans            &trans            &trans                &trans      &trans      &kp UP_ARROW       &trans           &trans  &trans
&kp LEFT_SHIFT  &sk LEFT_CONTROL  &sk LEFT_ALT   &sk LEFT_COMMAND  &trans            &trans                &trans      &kp LEFT    &kp DOWN           &kp RIGHT        &trans  &trans
                                                 &trans            &trans            &trans                &trans      &trans      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        l3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
